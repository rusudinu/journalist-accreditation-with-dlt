{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.org/journalist-credentials/schema/v1",
  "title": "Journalist Accreditation Credential",
  "description": "Schema for Journalist Accreditation Verifiable Credentials",
  "type": "object",
  "required": [
    "@context",
    "id",
    "type",
    "issuer",
    "issuanceDate",
    "credentialSubject"
  ],
  "properties": {
    "@context": {
      "type": "array",
      "minItems": 2,
      "items": [
        {
          "type": "string",
          "const": "https://www.w3.org/2018/credentials/v1"
        },
        {
          "type": "string",
          "const": "https://example.org/journalist-credentials/v1"
        }
      ]
    },
    "id": {
      "type": "string",
      "format": "uri",
      "description": "Unique identifier for the credential"
    },
    "type": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      },
      "contains": {
        "const": "VerifiableCredential"
      }
    },
    "issuer": {
      "oneOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": {
              "type": "string",
              "format": "uri"
            },
            "name": {
              "type": "string"
            }
          }
        }
      ]
    },
    "issuanceDate": {
      "type": "string",
      "format": "date-time",
      "description": "Date and time when the credential was issued"
    },
    "expirationDate": {
      "type": "string",
      "format": "date-time",
      "description": "Optional expiration date for the credential"
    },
    "credentialSubject": {
      "type": "object",
      "required": [
        "id",
        "type",
        "accreditationNumber",
        "fullName",
        "organization",
        "validFrom",
        "validUntil"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uri",
          "description": "DID or URI of the credential subject"
        },
        "type": {
          "type": "string",
          "const": "Journalist"
        },
        "accreditationNumber": {
          "type": "string",
          "pattern": "^J-[0-9]{4}-[0-9]{5}$",
          "description": "Unique accreditation number in format J-YYYY-NNNNN"
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "organization": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "validFrom": {
          "type": "string",
          "format": "date-time"
        },
        "validUntil": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "proof": {
      "type": "object",
      "required": [
        "type",
        "created",
        "proofPurpose",
        "verificationMethod",
        "jws"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["Ed25519Signature2020", "JsonWebSignature2020"]
        },
        "created": {
          "type": "string",
          "format": "date-time"
        },
        "proofPurpose": {
          "type": "string",
          "enum": ["assertionMethod", "authentication"]
        },
        "verificationMethod": {
          "type": "string",
          "format": "uri",
          "description": "DID URL referencing the verification method"
        },
        "jws": {
          "type": "string",
          "description": "JSON Web Signature"
        }
      }
    }
  }
}
